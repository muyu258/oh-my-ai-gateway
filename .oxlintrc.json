{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["nextjs", "react", "typescript"],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "build/**",
    "src/lib/database/drizzle/migrations/**",
    "next-env.d.ts"
  ]
}
